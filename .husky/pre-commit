#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Lint before commit. Type-checking is intentionally NOT run here: the web app
# still carries pre-existing TS errors, and a strict `pnpm typecheck` would block
# every commit. Run `pnpm typecheck` (or `pnpm validate` = lint + typecheck)
# manually / in CI, and restore `pnpm run validate` here once the web app is clean.
pnpm run lint
