# ============================================
# Zonds Web - Production Docker Image
# Multi-stage: Node.js build → nginx serve
# ============================================

# ---- Build Stage ----
FROM node:20-bookworm AS builder

RUN corepack enable && corepack prepare pnpm@8.6.12 --activate

WORKDIR /app
COPY . .

# Vite build-time environment variables
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_NODE_ENV=production
ARG VITE_ENABLE_AUTH=true
# Must match the api service's EBAY_ENVIRONMENT: buyer-facing item links are
# built from it, and a sandbox item id is a dead link on ebay.com.
ARG VITE_EBAY_ENVIRONMENT=production
ARG VITE_GOOGLE_CLIENT_ID=
# tawk.to live-chat widget (optional — hidden when either is empty). See
# CLAUDE.md "Customer support widget — tawk.to" for where to get these.
ARG VITE_TAWKTO_PROPERTY_ID=
ARG VITE_TAWKTO_WIDGET_ID=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_NODE_ENV=$VITE_NODE_ENV
ENV VITE_ENABLE_AUTH=$VITE_ENABLE_AUTH
ENV VITE_EBAY_ENVIRONMENT=$VITE_EBAY_ENVIRONMENT
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_TAWKTO_PROPERTY_ID=$VITE_TAWKTO_PROPERTY_ID
ENV VITE_TAWKTO_WIDGET_ID=$VITE_TAWKTO_WIDGET_ID

# Install dependencies and build in order (single layer for verbose error output)
RUN set -ex && \
    pnpm install --frozen-lockfile && \
    echo "=== INSTALL DONE ===" && \
    pnpm --filter @repo/shared run build && \
    echo "=== SHARED DONE ===" && \
    pnpm --filter @repo/ui run build && \
    echo "=== UI DONE ===" && \
    pnpm --filter web run build && \
    echo "=== WEB DONE ==="

# ---- Production Stage ----
FROM nginx:alpine

# Copy built static files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration (API proxy + SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx config to avoid conflicts
RUN rm -f /etc/nginx/conf.d/default.conf.bak

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
