# ============================================
# Zonds Web - Production Docker Image
# Multi-stage: Node.js build → nginx serve
# ============================================

# ---- Build Stage ----
FROM node:20-bookworm AS builder

RUN corepack enable && corepack prepare pnpm@8.6.12 --activate

WORKDIR /app
COPY . .

# Vite build-time environment variables
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_NODE_ENV=production
ARG VITE_ENABLE_AUTH=true

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_NODE_ENV=$VITE_NODE_ENV
ENV VITE_ENABLE_AUTH=$VITE_ENABLE_AUTH

# Install dependencies and build in order
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @repo/shared run build

# Debug: show TypeScript errors before building ui
RUN cd /app/packages/ui && npx tsc --noEmit || true
RUN pnpm --filter @repo/ui run build
RUN pnpm --filter web run build

# ---- Production Stage ----
FROM nginx:alpine

# Copy built static files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration (API proxy + SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx config to avoid conflicts
RUN rm -f /etc/nginx/conf.d/default.conf.bak

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
