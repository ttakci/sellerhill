# .gitignore additions for environment and data files

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker volumes and data
postgres_data/
redis_data/
pgadmin_data/

# Database backups
*.sql
!docker/postgres/init.sql
*.dump
*.backup

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
