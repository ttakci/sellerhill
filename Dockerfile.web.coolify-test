# ============================================
# Test: Simulate Coolify's ARG injection
# ============================================

# Coolify adds ARGs BEFORE the first FROM
ARG COOLIFY_FQDN
ARG JWT_REFRESH_SECRET
ARG CORS_ORIGIN
ARG FRONTEND_URL
ARG EBAY_CLIENT_ID
ARG EBAY_CLIENT_SECRET
ARG EBAY_REDIRECT_URI
ARG EBAY_RUNAME
ARG EBAY_ENVIRONMENT
ARG JWT_SECRET
ARG POSTGRES_PASSWORD
ARG SMTP_PORT
ARG SMTP_SECURE
ARG SMTP_USER
ARG SMTP_PASSWORD
ARG SMTP_FROM
ARG AMAZON_ENCRYPTION_KEY
ARG KEEPA_API_KEY
ARG SERVICE_URL_API
ARG SERVICE_FQDN_API
ARG SERVICE_URL_WEB
ARG SERVICE_FQDN_WEB
ARG EBAY_TOKEN_URL
ARG EBAY_REST_API_URL
ARG EBAY_XML_API_URL
ARG ZON_SCRAPPER_CONCURRENCY
ARG SMTP_HOST
ARG EBAY_AUTH_URL
ARG RATE_LIMIT_MAX
ARG ZON_SCRAPPER_TIMEOUT_MS
ARG ZON_SCRAPPER_USE_PROXY
ARG RATE_LIMIT_TTL

# ---- Build Stage ----
FROM node:20-bookworm AS builder

# Coolify adds same ARGs again inside each stage
ARG COOLIFY_FQDN
ARG JWT_REFRESH_SECRET
ARG CORS_ORIGIN
ARG FRONTEND_URL
ARG EBAY_CLIENT_ID
ARG EBAY_CLIENT_SECRET
ARG EBAY_REDIRECT_URI
ARG EBAY_RUNAME
ARG EBAY_ENVIRONMENT
ARG JWT_SECRET
ARG POSTGRES_PASSWORD
ARG SMTP_PORT
ARG SMTP_SECURE
ARG SMTP_USER
ARG SMTP_PASSWORD
ARG SMTP_FROM
ARG AMAZON_ENCRYPTION_KEY
ARG KEEPA_API_KEY
ARG SERVICE_URL_API
ARG SERVICE_FQDN_API
ARG SERVICE_URL_WEB
ARG SERVICE_FQDN_WEB
ARG EBAY_TOKEN_URL
ARG EBAY_REST_API_URL
ARG EBAY_XML_API_URL
ARG ZON_SCRAPPER_CONCURRENCY
ARG SMTP_HOST
ARG EBAY_AUTH_URL
ARG RATE_LIMIT_MAX
ARG ZON_SCRAPPER_TIMEOUT_MS
ARG ZON_SCRAPPER_USE_PROXY
ARG RATE_LIMIT_TTL

RUN corepack enable && corepack prepare pnpm@8.6.12 --activate

WORKDIR /app
COPY . .

# Vite build-time environment variables
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_NODE_ENV=production
ARG VITE_ENABLE_AUTH=true

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_NODE_ENV=$VITE_NODE_ENV
ENV VITE_ENABLE_AUTH=$VITE_ENABLE_AUTH

# Install dependencies and build in order
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @repo/shared run build
RUN pnpm --filter @repo/ui run build
RUN pnpm --filter web run build

# ---- Production Stage ----
FROM nginx:alpine

# Coolify adds ARGs to this stage too
ARG COOLIFY_FQDN
ARG JWT_REFRESH_SECRET
ARG CORS_ORIGIN
ARG FRONTEND_URL
ARG EBAY_CLIENT_ID
ARG EBAY_CLIENT_SECRET
ARG EBAY_REDIRECT_URI
ARG EBAY_RUNAME
ARG EBAY_ENVIRONMENT
ARG JWT_SECRET
ARG POSTGRES_PASSWORD
ARG SMTP_PORT
ARG SMTP_SECURE
ARG SMTP_USER
ARG SMTP_PASSWORD
ARG SMTP_FROM
ARG AMAZON_ENCRYPTION_KEY
ARG KEEPA_API_KEY
ARG SERVICE_URL_API
ARG SERVICE_FQDN_API
ARG SERVICE_URL_WEB
ARG SERVICE_FQDN_WEB
ARG EBAY_TOKEN_URL
ARG EBAY_REST_API_URL
ARG EBAY_XML_API_URL
ARG ZON_SCRAPPER_CONCURRENCY
ARG SMTP_HOST
ARG EBAY_AUTH_URL
ARG RATE_LIMIT_MAX
ARG ZON_SCRAPPER_TIMEOUT_MS
ARG ZON_SCRAPPER_USE_PROXY
ARG RATE_LIMIT_TTL

# Copy built static files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration (API proxy + SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx config to avoid conflicts
RUN rm -f /etc/nginx/conf.d/default.conf.bak

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
