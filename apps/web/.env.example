# Environment Variables for Web App
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Application Configuration
VITE_APP_NAME=React NestJS Template
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# eBay environment — MUST match the API's EBAY_ENVIRONMENT (sandbox | production).
# Buyer-facing item links are built from this: a sandbox item id is a dead link
# on ebay.com, so sandbox deployments must set `sandbox` here too.
VITE_EBAY_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_AUTH=false
VITE_ENABLE_ANALYTICS=false

# Development
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_MOCK_API=false

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# Third-party Services (Optional)
# VITE_FIREBASE_API_KEY=
# VITE_STRIPE_PUBLIC_KEY=

# Google Identity Services (popup auth-code). Same Client ID as API GOOGLE_CLIENT_ID.
# Leave empty to hide the Google button on login/register.
VITE_GOOGLE_CLIENT_ID=
