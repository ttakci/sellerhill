# Environment Variables for Web App
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Application Configuration
VITE_APP_NAME=React NestJS Template
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# eBay environment — MUST match the API's EBAY_ENVIRONMENT (sandbox | production).
# Buyer-facing item links are built from this: a sandbox item id is a dead link
# on ebay.com, so sandbox deployments must set `sandbox` here too.
VITE_EBAY_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_AUTH=false
VITE_ENABLE_ANALYTICS=false

# Development
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_MOCK_API=false

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# Third-party Services (Optional)
# VITE_FIREBASE_API_KEY=

# Stripe publishable key (pk_test_... / pk_live_...). NOT consumed by any FE
# code today — checkout and the billing portal are redirect-based (the backend
# returns a Stripe-hosted URL and the browser goes there), so no Stripe.js /
# Elements surface needs it yet. Provisioned ahead of time for when one is
# built. Safe to expose client-side (publishable, not secret).
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Identity Services (popup auth-code). Same Client ID as API GOOGLE_CLIENT_ID.
# Leave empty to hide the Google button on login/register.
VITE_GOOGLE_CLIENT_ID=

# tawk.to live-chat widget ("contact us" bubble on the landing page + seller
# app). Get both IDs from your tawk.to dashboard -> Administration -> Channels
# -> Chat Widget (or from the widget's Direct Chat Link:
# tawk.to/chat/<propertyId>/<widgetId>). Leave either empty to hide the widget
# (e.g. local dev without a tawk.to account). See CLAUDE.md "Customer support
# widget — tawk.to" for full setup steps.
VITE_TAWKTO_PROPERTY_ID=6a77cbcad1e0df1d455e2131
VITE_TAWKTO_WIDGET_ID=1jvhv843q
