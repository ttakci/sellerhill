# Backend API Environment Variables (PRODUCTION)

# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=https://app.zonds.com

# Logging
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/db_name

# JWT Configuration
# JWT_SECRET=provide_a_strong_secret_here
JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=provide_a_strong_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# eBay OAuth Configuration
# Get your credentials from: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://api.zonds.com/api/v1/ebay/callback
EBAY_RUNAME=
EBAY_ENVIRONMENT=production

# eBay API URLs (Active: Production)
EBAY_AUTH_URL=https://auth.ebay.com/oauth2/authorize
EBAY_TOKEN_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_REST_API_URL=https://api.ebay.com
EBAY_XML_API_URL=https://api.ebay.com/ws/api.dll

# Keepa API Configuration
KEEPA_API_KEY=
KEEPA_API_URL=https://api.keepa.com/product

# Frontend URL
FRONTEND_URL=https://app.zonds.com

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Email Configuration 
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
