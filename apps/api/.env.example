# Environment Variables for API
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# CORS Configuration (comma-separated list of allowed origins)
# Also accepts legacy CORS_ORIGIN (singular)
CORS_ORIGINS=http://localhost:5173

# Refresh cookie (optional production overrides)
# COOKIE_DOMAIN=.takci.cloud
# COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=debug

# Database Configuration (for future use)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=template_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration
JWT_SECRET=change-me-in-production-your-super-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# eBay OAuth Configuration
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_REDIRECT_URI=http://localhost:3000/api/v1/ebay/callback
EBAY_RUNAME=your_ebay_runame_here
# EBAY_ENVIRONMENT options: sandbox or production
EBAY_ENVIRONMENT=sandbox

# eBay API URLs (Configure based on EBAY_ENVIRONMENT)
EBAY_AUTH_URL=https://auth.sandbox.ebay.com/oauth2/authorize
EBAY_TOKEN_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token
EBAY_REST_API_URL=https://api.sandbox.ebay.com
EBAY_XML_API_URL=https://api.sandbox.ebay.com/ws/api.dll

# Frontend URL (for redirects after OAuth)
FRONTEND_URL=http://localhost:5173

# Redis Configuration (for future caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Keepa API Configuration (sole product data provider: metadata + price + stock)
KEEPA_API_KEY=your_keepa_api_key_here

# ---------------------------------------------------------------------------
# LLM infra (OpenAI-compatible Chat Completions)
# ---------------------------------------------------------------------------
# The client speaks plain OpenAI Chat Completions — POST {LLM_BASE_URL}/chat/
# completions with a Bearer token — so the provider is an env change, never a
# code change. Verify any switch with `pnpm --filter api llm:check`.
#
#   Google Gemini (default): https://generativelanguage.googleapis.com/v1beta/openai
#                            key from https://aistudio.google.com/api-keys
#   OpenAI:                  https://api.openai.com/v1            (sk-...)
#   Groq:                    https://api.groq.com/openai/v1       (gsk-...)
#
# Anthropic is the one exception — it does not serve this shape (its API is
# /v1/messages with x-api-key), so Claude would need an adapter in LlmService.
#
# --- Listing provider (bulk) ------------------------------------------------
# Used by listing title/description rewrites AND eBay item-specific selection.
# This runs across thousands of products per bulk add, so pick the cheapest
# tier that does the job — the task is "compress a title to 80 chars" and
# "pick one value from an allowed list", not deep reasoning.
# Label only: recorded on every llm_usage_log row. The `llm:pricing` row must
# use the same value or the admin Costs tab cannot price the tokens.
LLM_PROVIDER=google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# NOTE: use a NON-THINKING model. A thinking model spends the token budget
# reasoning and returns finish_reason=length at our 256-token title cap — the
# title comes back truncated (measured on gemini-3.6-flash) or, on some local
# models, empty. The `-lite` Gemini tiers answer straight out in ~0.7s.
LLM_CONTENT_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=30000
# Master switch for AI title/description. Content AI additionally applies only
# when a listing settings group has aiTitleEnabled / aiDescriptionEnabled, and
# only on **new listing create** — never on Keepa refresh or stock sync.
# Togglable at /admin -> Settings (llm.contentEnabled) without a restart.
LLM_CONTENT_ENABLED=false

# --- Assistant provider (customer chatbot, low volume) ----------------------
# Each value falls back to the listing provider above when unset. Set these
# only when the chatbot should run somewhere else than bulk listing traffic.
#   LLM_ASSISTANT_BASE_URL=https://api.openai.com/v1
#   LLM_ASSISTANT_API_KEY=sk-...
#   LLM_ASSISTANT_MODEL=gpt-4o-mini
LLM_ASSISTANT_BASE_URL=
LLM_ASSISTANT_API_KEY=
LLM_ASSISTANT_MODEL=

# Let the model pick a required eBay item specific from the category's own
# allowed values, when no product data, curated default or prior can fill it.
# The answer is validated against that list and learned per category, so each
# (category, aspect) question is asked once. Also togglable at /admin -> Settings.
EBAY_ASPECTS_LLM_ENABLED=false
EBAY_ASPECTS_LLM_MAX_PER_LISTING=3
# Listings create worker concurrency. A free provider tier has a low
# requests-per-minute ceiling — keep this at 1 there, 2-4 once billing is on.
LISTINGS_WORKER_CONCURRENCY=2

# Keepa stale-driven refresh pipeline (all optional — defaults shown)
# Master switch: 'false' disables the background refresh scheduler entirely
# (create-path Keepa calls still work). Useful for token-budget testing.
KEEPA_REFRESH_ENABLED=true
# Refresh frequency. 12h=720, 6h=360, 3h=180. Changing this is config-only (no rewrite).
# NOTE: the offers+stock query costs ~6–14 tokens/ASIN when Keepa refreshes its
# offer cache (0 when cached <1h) — budget against the plan's refill rate.
KEEPA_REFRESH_INTERVAL_MINUTES=720
# Products claimed per scheduler tick (chunked internally at Keepa's 100/request limit).
KEEPA_REFRESH_BATCH_SIZE=50
# Scheduler cadence (default: every minute).
KEEPA_REFRESH_SCHEDULER_CRON=* * * * *
# Parallel refresh jobs.
KEEPA_REFRESH_WORKER_CONCURRENCY=1
# Claim lease: how far next_refresh_at is pushed when a tick claims a batch.
# Must exceed worst-case batch runtime incl. BullMQ retries.
KEEPA_REFRESH_CLAIM_LEASE_MINUTES=15
# Keepa-side cache tolerance (hours): serve Keepa's cached offer data younger
# than this for ~0 tokens; only force a live scrape (6 tokens/found page) when
# older. Unset = Keepa's ~1h default. E.g. 2 = accept up to 2h-old offer data.
# KEEPA_UPDATE_HOURS=2
# Poison-product quarantine: how far to push next_refresh_at after max failures.
KEEPA_REFRESH_QUARANTINE_MINUTES=1440
# Consecutive data failures before a product is quarantined (escalating 5m/15m/60m/240m backoff before that).
KEEPA_REFRESH_MAX_FAILURES=5

# Amazon Integration (32-byte hex key for AES-256-GCM credential encryption)
AMAZON_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Browser state directory for Playwright session persistence (optional)
# BROWSER_STATE_DIR=.browser-state
# Resident-Chromium memory bounding (I2 prod-gate fix). Each Amazon account
# owns its own persistent `launchPersistentContext` (~150-300MB RSS per
# process). To avoid OOM at multi-tenant scale, a periodic sweep closes cached
# contexts that are PROVABLY idle: zero open pages AND untouched for > TTL.
# `pages().length === 0` is the non-negotiable safety guard — an in-flight
# scrape/checkout always holds a page, so eviction cannot crash active work.
# BROWSER_CONTEXT_IDLE_TTL_MS=600000
# BROWSER_CONTEXT_SWEEP_INTERVAL_MS=120000

# Amazon order-list auto cost-capture (Task 7) — scrapes each buyer account's
# "Your Orders" page, matches to pending eBay orders, writes real Amazon costs.
# All optional — defaults shown. Selector changes on Amazon's side require a
# patch in amazon-scraping.service.ts (ORDER_LIST_SELECTORS).
# Cron cadence for the repeatable tick (default: every 30 minutes).
AMAZON_ORDER_SYNC_CRON='*/30 * * * *'
# Parallel per-account sync jobs the worker pulls.
AMAZON_ORDER_SYNC_CONCURRENCY=2
# Strict matcher: max % difference between Amazon grand total and eBay sale total.
AMAZON_ORDER_SYNC_MATCH_TOLERANCE_PCT=5
# Strict matcher: max days between eBay sale date and Amazon purchase date.
AMAZON_ORDER_SYNC_MATCH_WINDOW_DAYS=7


# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com

# A2 — Automated Amazon fulfillment (all optional; proxy REQUIRED to enable auto_fulfill on any account)
AUTO_FULFILL_QUEUE_CONCURRENCY=1
AUTO_FULFILL_CHECKOUT_MIN_TIME_MS=4500
AUTO_FULFILL_REVIEW_CAP_HARD_STOP=true
FULFILLMENT_EVIDENCE_DIR=
FULFILLMENT_EVIDENCE_TTL_DAYS=7

# Amazon order tracking poll cadence (hours). Pre-ship: how fast we detect
# "shipped" and push tracking to eBay (default 6). Shipped: delivered-detection
# only (no time-critical side effect; default 24).
AMAZON_TRACKING_PRESHIP_INTERVAL_HOURS=6
AMAZON_TRACKING_SHIPPED_INTERVAL_HOURS=24

# Proxy — PRIMARY model: fixed ISP proxy pool in the `proxies` DB table
# (migration 057). Manage it from the admin panel (/admin → Proxies tab): add a
# purchased proxy with host/port/username/password + expiry + monthly cost, and
# disable burned ones. Each user is auto-assigned ONE static proxy on first
# need. Passwords are encrypted at rest and never returned. No env needed.
#
# LEGACY fallback (used only while the proxies table has no active rows):
# a single rotating-residential template with a sticky {session} token.
PROXY_PROVIDER=              # informational only (no runtime branch)
PROXY_ENDPOINT=              # e.g. gate.smartproxy.com:7000
PROXY_USER=                  # base username; may contain {session}
PROXY_PASS_TEMPLATE=         # may contain {session}
PROXY_STRATEGY=perUser       # perUser (default) | perAccount — legacy fallback only

# ---------------------------------------------------------------------------
# RUNTIME-TUNABLE SETTINGS (managed at /admin -> Settings)
#
# Everything below this line is a FALLBACK. Each of these keys is in the
# platform-settings registry, so an admin can override it from the panel and
# the override wins; the env var only applies when no override row exists.
# Resolution is: platform_settings row -> env var -> code default.
#
# Secrets and bootstrap config (DATABASE_*, REDIS_*, JWT_*,
# AMAZON_ENCRYPTION_KEY, KEEPA_API_KEY, EBAY_*, GOOGLE_*, PADDLE_*,
# LLM_API_KEY, NODE_ENV, PORT, CORS_ORIGINS) are deliberately NOT in the
# registry — they are read before the DB exists and must not be reachable
# over HTTP.
#
# Settings marked "restart" below are consumed once at boot (repeatable job
# cron patterns, worker concurrency); the panel shows the same warning.
# ---------------------------------------------------------------------------

# Admin panel soft thresholds. These drive in-page warnings only — no external
# alert delivery exists yet.
ADMIN_QUEUE_WAITING_THRESHOLD=100
ADMIN_KEEPA_LOW_TOKENS_THRESHOLD=100
ADMIN_LLM_FAILURE_RATE_THRESHOLD=10
ADMIN_LISTING_QUOTA_WARN_THRESHOLD=25
ADMIN_LISTING_QUOTA_CRITICAL_THRESHOLD=100
ADMIN_AMAZON_ACCOUNT_QUOTA_WARN_THRESHOLD=3
ADMIN_AMAZON_ACCOUNT_QUOTA_CRITICAL_THRESHOLD=10
# Days before a proxy's expires_at that it is flagged EXPIRING_SOON. A lapsed
# fixed ISP proxy releases its static IP, breaking the assigned user's IP
# continuity — renew before this window closes.
ADMIN_PROXY_EXPIRY_WARN_DAYS=7

# Google OAuth (GIS popup auth-code). Optional — without these, POST /auth/google returns 503
# and the FE hides the Google button when VITE_GOOGLE_CLIENT_ID is empty.
# Create a Web application OAuth client; Authorized JavaScript origins = FE origin(s).
# Authorized redirect URIs can stay empty (GIS uses postmessage).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (phase 2) — subscription billing via Paddle.
# All optional. BILLING_ENFORCEMENT_ENABLED defaults to false: the app runs in
# "full access" transition mode and GET /billing/summary reports
# transition='full_access' with NO fake subscription. Set to true only after a
# provider is wired and plans are meant to gate features. No quota integration
# is wired yet — enforcement is reported but not applied to listings/orders.
BILLING_ENFORCEMENT_ENABLED=false
# Paddle server-to-server API key (used for checkout/portal if the provider
# needs a server round-trip). Leave empty in dev.
PADDLE_API_KEY=
# Paddle webhook secret — the HMAC key used to verify the Paddle-Signature
# header on POST /billing/webhooks. Required for webhooks to be accepted;
# without it the endpoint 401s (fail-closed).
PADDLE_WEBHOOK_SECRET=
# sandbox (test) | production (live)
PADDLE_ENVIRONMENT=sandbox
# Paddle checkout/API base URLs (defaults shown; override per environment).
PADDLE_CHECKOUT_BASE_URL=https://checkout.paddle.com
PADDLE_API_BASE_URL=https://api.paddle.com
# Stale-webhook protection: drop events older than N minutes after logging.
# 0 = no staleness drop. Default 24h.
BILLING_WEBHOOK_STALE_MINUTES=1440
# Max processing attempts before a webhook event is marked failed.
BILLING_WEBHOOK_MAX_ATTEMPTS=5

# --- Buyer auto-messaging ---------------------------------------------
# Opt-in is per-user via Store Settings (master toggle + per-event). The only
# env here is the default feedback-request delay (days after delivery).
BUYER_MESSAGING_FEEDBACK_DEFAULT_DELAY_DAYS=3
