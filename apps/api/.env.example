# Environment Variables for API
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Database Configuration (for future use)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=template_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration
JWT_SECRET=change-me-in-production-your-super-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# eBay OAuth Configuration
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_REDIRECT_URI=http://localhost:3000/api/v1/ebay/callback
EBAY_RUNAME=your_ebay_runame_here
# EBAY_ENVIRONMENT options: sandbox or production
EBAY_ENVIRONMENT=sandbox

# eBay API URLs (Configure based on EBAY_ENVIRONMENT)
EBAY_AUTH_URL=https://auth.sandbox.ebay.com/oauth2/authorize
EBAY_TOKEN_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token
EBAY_REST_API_URL=https://api.sandbox.ebay.com
EBAY_XML_API_URL=https://api.sandbox.ebay.com/ws/api.dll

# Frontend URL (for redirects after OAuth)
FRONTEND_URL=http://localhost:5173

# Redis Configuration (for future caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ScraperAPI Configuration
SCRAPER_API_KEY=your_scraper_api_key_here

# Email Configuration 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
