{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:prod": "set NODE_ENV=production&& ts-node-dev --respawn --transpile-only src/main.ts",
    "serve": "node dist/main.js",
    "serve:prod": "set NODE_ENV=production&& node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "user:set-role": "tsx src/scripts/user-set-role.ts",
    "reset-users": "tsx src/scripts/reset-users.ts",
    "llm:check": "tsx src/scripts/llm-check.ts",
    "llm:pricing": "tsx src/scripts/llm-pricing-set.ts",
    "ebay:aspect-probe": "tsx src/scripts/ebay-aspect-probe.ts",
    "stripe:sync-catalog": "tsx src/scripts/stripe-sync-catalog.ts",
    "aquiline:probe": "tsx src/scripts/aquiline-probe.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@repo/shared": "workspace:*",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.66.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "nest-winston": "^1.9.4",
    "nodemailer": "^7.0.12",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react-hot-toast": "^2.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "stripe": "^22.4.0",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^11.0.0",
    "jest": "^29.7.0",
    "testcontainers": "^10.18.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
