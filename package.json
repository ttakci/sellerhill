{
  "name": "react-nestjs-nodejs-nx-monorepo",
  "version": "1.0.0",
  "description": "React + NestJS pnpm Monorepo Template",
  "license": "MIT",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @repo/* run build && pnpm -r --parallel --filter web --filter api run dev",
    "dev:prod": "pnpm -r --parallel --filter @repo/* run build && pnpm -r --parallel --filter web run dev && pnpm -r --filter api run dev:prod",
    "dev:web": "pnpm -r --filter @repo/* run build && pnpm --filter web run dev",
    "dev:api": "pnpm -r --filter @repo/* run build && pnpm --filter api run dev",
    "dev:api:prod": "pnpm -r --filter @repo/* run build && pnpm --filter api run dev:prod",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --cache --fix",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm run lint && pnpm run typecheck",
    "prepare": "husky install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "migrate": "pnpm --filter api run migrate",
    "user:set-role": "pnpm --filter api run user:set-role"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@reduxjs/toolkit": "^1.9.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.55.0",
    "eslint-plugin-design-system": "file:packages\\ui\\src\\eslint-plugin",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "puppeteer": "^25.10.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.5",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.1",
      "i18next": "^25.7.4"
    }
  }
}
