{
  "name": "react-nestjs-nodejs-nx-monorepo",
  "version": "1.0.0",
  "description": "React + NestJS pnpm Monorepo Template",
  "license": "MIT",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @repo/* run build && pnpm -r --parallel --filter web --filter api run dev",
    "dev:web": "pnpm -r --filter @repo/* run build && pnpm --filter web run dev",
    "dev:api": "pnpm -r --filter @repo/* run build && pnpm --filter api run dev",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@reduxjs/toolkit": "^1.9.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "i18next": "^23.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "reflect-metadata": "^0.1.13",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.7",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.55.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "styled-components": "^6.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.2.7",
      "@types/react-dom": "18.2.7"
    }
  }
}
