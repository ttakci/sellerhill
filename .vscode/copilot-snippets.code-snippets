  "RTK Query API": {
    "prefix": "rtkapi",
    "scope": "typescript",
    "body": [
      "import { baseApi } from '@/services/api';",
      "import type {",
      "  ${1:Feature}Item,",
      "  Create${1:Feature}Request,",
      "  Get${1:Feature}sResponse,",
      "} from '@repo/shared';",
      "",
      "export const ${2:feature}sApi = baseApi.injectEndpoints({",
      "  endpoints: (builder) => ({",
      "    get${1:Feature}s: builder.query<Get${1:Feature}sResponse, void>({",
      "      query: () => ({",
      "        url: '/${2:feature}s',",
      "        method: 'GET',",
      "      }),",
      "      providesTags: ['${1:Feature}'],",
      "    }),",
      "",
      "    get${1:Feature}: builder.query<${1:Feature}Item, string>({",
      "      query: (id) => ({",
      "        url: \\`/${2:feature}s/\\${id}\\`,",
      "        method: 'GET',",
      "      }),",
      "      providesTags: (result, error, id) => [{ type: '${1:Feature}', id }],",
      "    }),",
      "",
      "    create${1:Feature}: builder.mutation<${1:Feature}Item, Create${1:Feature}Request>({",
      "      query: (body) => ({",
      "        url: '/${2:feature}s',",
      "        method: 'POST',",
      "        body,",
      "      }),",
      "      invalidatesTags: ['${1:Feature}'],",
      "    }),",
      "  }),",
      "});",
      "",
      "export const {",
      "  useGet${1:Feature}sQuery,",
      "  useGet${1:Feature}Query,",
      "  useCreate${1:Feature}Mutation,",
      "} = ${2:feature}sApi;",
      ""
    ],
    "description": "Create RTK Query API following project patterns"
  },

  "NestJS Controller": {
    "prefix": "controller",
    "scope": "typescript",
    "body": [
      "import {",
      "  Controller,",
      "  Get,",
      "  Post,",
      "  Body,",
      "  Param,",
      "  Query,",
      "  UseGuards,",
      "  HttpCode,",
      "  HttpStatus,",
      "} from '@nestjs/common';",
      "import { ApiTags, ApiOperation } from '@nestjs/swagger';",
      "",
      "import { ${1:Feature}sService } from './${2:feature}s.service';",
      "import { Create${1:Feature}Dto, List${1:Feature}sQueryDto } from './dto';",
      "",
      "@ApiTags('${2:feature}s')",
      "@Controller({",
      "  path: '${2:feature}s',",
      "  version: '1',",
      "})",
      "export class ${1:Feature}sController {",
      "  constructor(private readonly ${2:feature}sService: ${1:Feature}sService) {}",
      "",
      "  @Get()",
      "  @ApiOperation({ summary: 'Get all ${2:feature}s' })",
      "  async findAll(@Query() query: List${1:Feature}sQueryDto) {",
      "    return this.${2:feature}sService.findAll(query);",
      "  }",
      "",
      "  @Post()",
      "  @HttpCode(HttpStatus.CREATED)",
      "  @ApiOperation({ summary: 'Create ${2:feature}' })",
      "  async create(@Body() createDto: Create${1:Feature}Dto) {",
      "    return this.${2:feature}sService.create(createDto);",
      "  }",
      "}",
      ""
    ],
    "description": "Create NestJS controller following project patterns"
  },

