  "React Hook Form with Zod": {
    "prefix": "rhf",
    "scope": "typescriptreact",
    "body": [
      "import { useForm, Controller } from 'react-hook-form';",
      "import { zodResolver } from '@hookform/resolvers/zod';",
      "import { create${1:Feature}Schema } from '@repo/shared';",
      "import type { Create${1:Feature}FormData } from '@repo/shared';",
      "",
      "const {",
      "  control,",
      "  handleSubmit,",
      "  formState: { errors },",
      "  reset,",
      "} = useForm<Create${1:Feature}FormData>({",
      "  resolver: zodResolver(create${1:Feature}Schema),",
      "  defaultValues: {",
      "    name: '',",
      "  },",
      "});",
      "",
      "const onSubmit = async (data: Create${1:Feature}FormData) => {",
      "  try {",
      "    showLoading({ message: t('common.loading') });",
      "    await create${1:Feature}(data).unwrap();",
      "    showMessage({",
      "      type: 'success',",
      "      message: t('${2:feature}s.createSuccess'),",
      "    });",
      "    reset();",
      "  } catch (error) {",
      "    showMessage({",
      "      type: 'error',",
      "      message: t('common.error'),",
      "    });",
      "  } finally {",
      "    hideLoading();",
      "  }",
      "};",
      ""
    ],
    "description": "React Hook Form setup with Zod validation"
  },

  "forwardRef Input Component": {
    "prefix": "forwardref",
    "scope": "typescriptreact",
    "body": [
      "import React from 'react';",
      "",
      "import * as S from './${1:Component}.style';",
      "import type { ${1:Component}Props } from './${1:Component}.types';",
      "",
      "export const ${1:Component} = React.forwardRef<HTMLInputElement, ${1:Component}Props>(",
      "  ({ value, onChange, error, ...props }, ref) => {",
      "    return (",
      "      <S.Container>",
      "        <S.Input",
      "          ref={ref}",
      "          value={value}",
      "          onChange={onChange}",
      "          {...props}",
      "        />",
      "        {error && <S.Error>{error}</S.Error>}",
      "      </S.Container>",
      "    );",
      "  }",
      ");",
      "",
      "${1:Component}.displayName = '${1:Component}';",
      ""
    ],
    "description": "Create forwardRef component for React Hook Form"
