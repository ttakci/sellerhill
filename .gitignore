# Dependencies
node_modules/

# Build outputs
/dist/
/build/
apps/*/dist/
apps/*/build/
packages/*/dist/

# TypeScript build artifacts in src (should only be in dist/)
**/*.js
**/*.js.map
**/*.d.ts
**/*.d.ts.map
!packages/ui/src/**/*.d.ts
!*.config.js
!*.config.cjs
!*.config.mjs
!scripts/**/*.js
!scripts/**/*.mjs
!packages/*/scripts/*.js
!packages/ui/src/eslint-plugin/*.js
!.claude/hooks/*.js

# Env files
.env
.env.local
.env.*.local
apps/web/.env
apps/web/.env.local
apps/api/.env
apps/api/.env.local

# Docker volumes and data
postgres_data/
redis_data/
pgadmin_data/

# Database backups
*.sql
!docker/postgres/init.sql
!apps/api/migrations/*.sql
*.dump
*.backup

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite cache
apps/web/.vite/

# Coverage
coverage/

# OS/editor
.DS_Store
# ESLint cache
.eslintcache

# Keep VS Code workspace settings for Copilot configuration
# .vscode/

# Backup files
*.bak

# Playwright MCP session artifacts (logs/page snapshots)
.playwright-mcp/
